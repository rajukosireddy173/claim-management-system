        <name>Calculate Total - On minors Change</name>
        <order/>
        <published_ref/>
        <script><![CDATA[function calculateTotalCost() {
    var majors = parseFloat(g_form.getValue('majors')) || 0;
    var minors = parseFloat(g_form.getValue('minors')) || 0;
    var costMajors = parseFloat(g_form.getValue('cost_of_majors')) || 0;
    var costMinors = parseFloat(g_form.getValue('cost_of_minors')) || 0;

    var total = (majors * costMajors) + (minors * costMinors);
    g_form.setValue('total_cost', total.toFixed(2));
}

function onChange(control, oldValue, newValue) {
    calculateTotalCost();
}]]></script>
